# EF Core writes the files in this directory, and scripts/squash-migrations.sh folds a release's migrations into one.
# Only the diagnostics those two actually trip are relaxed, and only here, so a migration is still compiled, still
# analyzed for correctness, and still reviewed as SQL before it is applied.
#
# This file is not generated: both write *.cs files beside it and neither touches it.

# IDE0073 is deliberately left enforced: the copyright and license header is a property of every file in this
# repository, and the regeneration script writes it into each generated file rather than the rule being relaxed for
# them.

[*.cs]
dotnet_diagnostic.CA1707.severity = none # A release migration is named for its version, Release_0_9_0, which no PascalCase spelling keeps readable.
dotnet_diagnostic.CA1825.severity = none # Avoid unnecessary zero-length array allocations.
dotnet_diagnostic.CA1861.severity = none # Prefer static readonly fields over constant array arguments.
dotnet_diagnostic.IDE0005.severity = none # Using directive is unnecessary.
